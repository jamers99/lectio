def get(url, **headers):
    request = urllib.request.Request(url, headers={"User-Agent": "lectio", **headers})
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.read().decode()


def fetch_esv(book, chapter, key):
    query = urllib.parse.urlencode({
        "q": f"{book} {chapter}",
        "include-passage-references": "false",
        "include-audio-link": "false",
        "include-short-copyright": "false",
    })
    passage = json.loads(get(f"https://api.esv.org/v3/passage/html/?{query}", Authorization=f"Token {key}"))["passages"][0]
    return re.sub(r">(?:&nbsp;)+", ">", passage)  # poetry indents are runs of &nbsp;; CSS indents instead


def fetch_nlt(book, chapter, key):
    query = urllib.parse.urlencode({"ref": f"{book}.{chapter}", "version": "NLT", "key": key})
    return get(f"https://api.nlt.to/api/passages?{query}")


